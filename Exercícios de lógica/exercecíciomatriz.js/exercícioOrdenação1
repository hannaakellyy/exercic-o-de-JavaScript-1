let vetor = [3,6,9,10];

function ordenar (A,N){
    
    for (let i = 0; i<N; i++){
        for (let j = 0; j<N-1; j++){
            
            if (A[j]> A[j+1]){
                let aux = A[j]
                A[j] = A[j+1]
                A [j+1] = aux
            }
        }
    }
}
ordenar (vetor, vetor.length);
